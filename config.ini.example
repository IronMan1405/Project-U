[ollama]
endpoint = http://127.0.0.1:11434
model = gemma4:e4b

[utilities]
# Comma-separated macOS applications U may open, always after your confirmation.
allowed_apps = Calendar, Notes

[utility_folders]
# Label = folder. U may search file names in these folders and open documents in them
# (opening always asks first). Folders must be inside your home folder; ~/Library and
# hidden folders are refused. Remove this section to disable file search and opening.
Documents = ~/Documents

[voice]
# Local push-to-talk. Remove this section to turn voice off. Install with
# `brew install ffmpeg whisper.cpp` and place ggml-base.en.bin in data/models/ (see README).
# These paths are for Homebrew on Apple Silicon. On an Intel Mac, Homebrew uses
# /usr/local/bin instead; run `command -v ffmpeg whisper-cli` to find the right paths.
ffmpeg = /opt/homebrew/bin/ffmpeg
whisper_cli = /opt/homebrew/bin/whisper-cli
whisper_model = data/models/ggml-base.en.bin
language = en
max_seconds = 60
# Spoken replies use macOS `say`; leave say_voice empty for the system voice.
speech_output = on
say_voice =
