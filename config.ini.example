[ollama]
endpoint = http://127.0.0.1:11434
model = gemma4:e4b

[utilities]
# Comma-separated macOS applications K.R.I.S. may open. One you name ("open Notes") opens at once;
# one K.R.I.S. picks by itself asks for your confirmation first.
allowed_apps = Calendar, Notes

[utility_folders]
# Label = folder. U may search file names in these folders and open documents in them
# (opening always asks first). Folders must be inside your home folder; ~/Library and
# hidden folders are refused. Remove this section to disable file search and opening.
Documents = ~/Documents

[projects]
# Label = folder of a local code project K.R.I.S. may inspect: read-only Git status, change
# summaries (line counts, never file contents) and recent commits. Folders must be inside your
# home folder. Remove this section to turn the developer tools off.
# Project-U = ~/Project-U

[project_tests]
# Label = the command that runs that project's tests, one per line. Run from the project folder
# without a shell (no pipes, &&, or variables); the program is a path inside the project or a
# command on PATH. Nothing is ever installed. Asking "run the tests" runs exactly these.
# Project-U = .venv/bin/python -m unittest discover -s tests
#     node --test tests/js/

[developer]
# The application that "open <project> in my editor" uses.
editor = Visual Studio Code
# Each test command is stopped after this many seconds (10-1800).
test_timeout_seconds = 300

[ui]
# The Tasks tab is hidden because Apple Reminders is the reminder workflow; tasks still work
# through chat and in briefings. Set to on to show the tab again.
tasks_tab = off

[resource_alerts]
# One macOS notification when a resource stays high, and another only after it has recovered
# (fallen recovery_margin points below the warning level) and crossed again.
enabled = on
notifications = on
# Also speak new alerts through K.R.I.S.'s voice, only while it is idle.
speech = off
sample_interval_seconds = 10
# Samples in a row at or above a warning level before alerting (3 x 10 s = 30 s).
sustained_samples = 3
cpu_warning = 90
memory_warning = 90
# GPU utilization is best effort; Macs that do not report it are never alerted on.
gpu_warning = 90
recovery_margin = 10
# macOS thermal pressure level that alerts: fair, serious or critical.
thermal_warning = serious

[ui_control]
# Apps whose named buttons, menu items and text fields K.R.I.S. may inspect and act on, through
# macOS Accessibility (allow the app that runs K.R.I.S. under Privacy & Security > Accessibility).
# Pressing and typing are always approved first. Browsers, Terminal, System Settings and similar
# apps can never be listed. Leave empty to keep this off.
apps = Finder, Calculator, TextEdit

[voice]
# Local push-to-talk. Remove this section to turn voice off. Install with
# `brew install ffmpeg whisper.cpp` and place ggml-base.en.bin in data/models/ (see README).
# These paths are for Homebrew on Apple Silicon. On an Intel Mac, Homebrew uses
# /usr/local/bin instead; run `command -v ffmpeg whisper-cli` to find the right paths.
ffmpeg = /opt/homebrew/bin/ffmpeg
whisper_cli = /opt/homebrew/bin/whisper-cli
whisper_model = data/models/ggml-base.en.bin
language = en
max_seconds = 60
# Hands-free only: stop automatically after this much silence following speech, and
# never sooner than min_recording_ms after starting (milliseconds).
end_silence_ms = 1200
min_recording_ms = 600
# Wake word: return to standby after this many seconds without speech (3-30, and
# shorter than max_seconds).
wake_follow_up_seconds = 8
# Spoken replies use Kokoro-82M when its files are in data/models/ (see README),
# otherwise macOS `say`. tts_engine = say always uses say.
speech_output = on
tts_engine = kokoro
kokoro_voice = af_heart
kokoro_speed = 1.0
# The voice `say` uses as the fallback; leave empty for the system voice.
say_voice =

# [google]
# Optional: the organisation's Google Workspace Gmail and Calendar, read-only (see README).
# Keep the Desktop-app OAuth client file outside this repository. Uncomment to enable.
# client_secrets_file = ~/Library/Application Support/KRIS/google-oauth-client.json
# workspace_domain = example.org
# Local name of the first Google account and the first default; more accounts are added from
# chat ("connect my work Google account") and listed in data/google_accounts.json (no tokens).
# default_account = personal
